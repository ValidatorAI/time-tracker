# ─────────────────────────────────────────────────────────────
#  Time Tracker — environment variables
#  Every setting is read with the TIME_TRACKER_ prefix.
#  Copy this file to .env and adjust as needed.
# ─────────────────────────────────────────────────────────────

# --- the "special" app variable: where the SQLite database lives -----
# Relative paths are resolved against the project root.
# Use an absolute path for a shared/persistent location, e.g.
#   TIME_TRACKER_DB_PATH=/var/lib/time-tracker/time_tracker.db
TIME_TRACKER_DB_PATH=./data/time_tracker.db

# --- server binding ---------------------------------------------------
TIME_TRACKER_HOST=127.0.0.1
TIME_TRACKER_PORT=8787
TIME_TRACKER_LOG_LEVEL=info

# --- runtime ----------------------------------------------------------
# dev | prod  (dev => auto-reload + verbose errors)
TIME_TRACKER_ENV=dev

# IANA timezone used to decide which calendar day an entry belongs to.
# Leave empty to auto-detect the machine's timezone.
TIME_TRACKER_TIMEZONE=

# false => reject entries that overlap an existing entry (409)
TIME_TRACKER_ALLOW_OVERLAP=false

# Comma-separated list, or * for any origin.
TIME_TRACKER_CORS_ORIGINS=*

# Maximum characters allowed in an entry's note.
TIME_TRACKER_MAX_NOTE_LENGTH=2000
